-- the MeshPart's MeshId and `texture` its TextureID after import; `size` is
-- the mesh's own bounds (2 x 2 x 0.559 studs, front and back both carrying the
-- snout). An empty id falls back to the drawn HUD coin.
Config.COIN_MESH = {
