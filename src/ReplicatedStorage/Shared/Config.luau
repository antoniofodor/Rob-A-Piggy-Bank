	hoverdisc = {
		name = "Hoverdisc", style = "hoverdisc", order = 6,
		-- EPIC RATHER THAN LEGENDARY, ON THE DESIGNER'S CALL, and the speed is
		-- what settled it: this ride has always moved at 1.8, which is the
