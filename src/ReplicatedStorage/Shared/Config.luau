	og = {
		name = "Piggy Crate",
		order = 1,
		collection = "og",
		tier = "common",
		kind = "skin",
		odds = { common = 52, rare = 32, epic = 12, legendary = 4 },
		-- THE ROBUX LADDER IS THE COIN LADDER'S OWN RATIO, 1 : 3 : 12
