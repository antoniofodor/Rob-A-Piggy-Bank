# Rojo build output -- regenerate with `rojo build default.project.json -o RobAPiggyBank.rbxlx`
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Studio / OS noise
*.bak
Thumbs.db
.DS_Store

# Generated 3D source. These are the INPUT to an upload rather than the thing
# that ships -- what ships is an asset id in Config.PIGGY_MESH and its
# neighbours, and a Roblox asset outlives any file here. A .glb is also
# undiffable and permanent: git keeps every version of one forever, so a
# 21MB acorn is 21MB in every clone this repo ever has.
assets/**/*.glb
assets/**/*.fbx

# Current animal skin import packages live beside their maps and handoffs --
# under assets/piggies/<tier>/<key>/package/ since 2026-09-22 (the old tier folders
# only hold the designer's copies to clean up).
!assets/skins/animal/**/*.fbx
!assets/skins/animal/**/*.glb
assets/skins/animal/**/*.blend1
!assets/piggies/**/*.fbx
!assets/piggies/**/*.glb

# The loot bag the shop's Bigger Sack artwork is cut from. Same call as the
# piggy packages: the FBX IS the deliverable here -- it is what the designer
# opens and uploads -- so a clone that cannot see it has nothing to upload.
!assets/loot-bag/**/*.fbx

# Approved shop icon pack includes the actual game-import deliverables.
!assets/shop-ui/icon-system-v1/models/**/*.glb
!assets/shop-ui/icon-system-v1/models/**/*.fbx
!assets/shop-ui/icon-system-v1/crates/**/*.glb
!assets/shop-ui/icon-system-v1/crates/**/*.fbx
assets/shop-ui/icon-system-v1/sources/*.blend1

# Python bytecode from tests/sim and asset tooling.
__pycache__/
*.pyc

# Staged copies for Studio bulk upload. Rebuilt on demand from
# assets/skins/animal/**; never a source of truth, never committed.
import/
